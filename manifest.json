{
  "manifest_version": 3,
  "name": "Universal Web Culler",
  "version": "1.1.0",
  "description": "Automatically culls off-screen elements using content-visibility to drastically reduce CPU, GPU, and RAM usage.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["inject.css"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com"
  }
}
